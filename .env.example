# Copy this file to .env.local and fill in any you want to enable.
# All are optional — the Support page and footer button hide themselves
# automatically when none are set. No specific provider is required.

# Your Ko-fi page, shown as the main button on the Support page.
VITE_SUPPORT_KOFI_URL=
VITE_SUPPORT_DONATION_URL=
VITE_SUPPORT_SPONSORSHIP_URL=
VITE_SUPPORT_OTHER_URL=

# Public origin of the deployed site, e.g. https://bench.example — enables
# sitemap.xml and absolute canonical / Open Graph URLs. Optional.
VITE_SITE_URL=

# Public code repository (e.g. https://github.com/you/bench). Optional; adds
# "Report a bug" and "Star it on GitHub" to the Support page.
VITE_PROJECT_REPO_URL=

# Email address for bug reports and tool requests (shown publicly; use one made
# for Bench). Optional; without it the feedback pop-up offers GitHub only.
VITE_FEEDBACK_EMAIL=

# Bench app (beta) downloads. While none is set, the site doesn't link to the app.
VITE_APP_VERSION=
VITE_APP_WINDOWS_URL=
VITE_APP_LINUX_APPIMAGE_URL=
VITE_APP_LINUX_DEB_URL=
