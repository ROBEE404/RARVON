{
  "rewrites": [{ "source": "/((?!assets/|ocr/|licenses/|icons/|sw.js|manifest.webmanifest|robots.txt|sitemap.xml|favicon.svg).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/ocr/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/ocr/lang/(.*)", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
