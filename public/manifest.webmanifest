{
  "name": "Rarvon — free local file tools",
  "short_name": "Rarvon",
  "description": "Free, ad-free, account-free tools for PDFs, images, video, audio and text — processed on your device.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#131519",
  "theme_color": "#131519",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Image to Text", "url": "/tools/image/to-text", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "PDF Editor", "url": "/tools/pdf/editor", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Compress", "url": "/compress", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
